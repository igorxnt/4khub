button("Importar configuração", function()
    local ok, data = pcall(function() return HttpService:JSONDecode(profileBox.Text) end)
    if not ok or type(data) ~= "table" then
        profileStatus.Text = "JSON inválido. Nenhuma configuração aplicada."
        return
    end
    local candidate = table.clone(settings)
    for key, value in pairs(data) do
        if defaults[key] == nil or typeof(value) ~= typeof(defaults[key]) then
            profileStatus.Text = "Campo desconhecido ou tipo inválido: " .. tostring(key)
            return
        end
        if limits[key] then
            if value ~= value or math.abs(value) == math.huge then
                profileStatus.Text = "Número inválido: " .. key
                return
            end
            candidate[key] = math.clamp(value, limits[key][1], limits[key][2])
        elseif key == "HubBind" or key == "AimBind" then
            if not validBinding(value) then
                profileStatus.Text = "Atalho inválido: " .. key
                return
            end
            candidate[key] = value
        elseif key == "AimMode" then
            if value ~= "Segurar" and value ~= "Alternar" then
                profileStatus.Text = "Modo de mira inválido."
                return
            end
            candidate[key] = value
        elseif key == "Target" then
            if value ~= "Head" and value ~= "HumanoidRootPart" then
                profileStatus.Text = "Alvo inválido."
                return
            end
            candidate[key] = value
        elseif key == "BoxStyle" then
            if value ~= "Completa" and value ~= "Cantos" then
                profileStatus.Text = "Estilo de box inválido."
                return
            end
            candidate[key] = value
        else candidate[key] = value end
    end
    if candidate.HubBind == candidate.AimBind then
        profileStatus.Text = "HUD e mira precisam de atalhos diferentes."
        return
    end
    resetInputState()
    for key, value in pairs(candidate) do settings[key] = value end
    for _, refresh in ipairs(refreshControls) do refresh() end
    profileStatus.Text = "Perfil aplicado."
end)
button("Restaurar padrões", function()
