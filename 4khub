local function slider(key, text, low, high, step)
    local row = create("Frame", {
        Size = UDim2.new(1, -6, 0, 44), BackgroundTransparency = 1, ZIndex = 12,
    }, list)
    local caption = create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 21), BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.Gotham,
        TextSize = 12, TextColor3 = theme.Text, ZIndex = 13,
    }, row)
    local track = create("TextButton", {
        Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 12),
        BackgroundColor3 = theme.Row, BorderSizePixel = 0,
        Text = "", AutoButtonColor = false, ZIndex = 13,
    }, row)
    corner(track, 6)
    local fill = create("Frame", {
        BackgroundColor3 = theme.Accent, BorderSizePixel = 0, ZIndex = 14,
    }, track)
    corner(fill, 6)
    local function refresh()
        fill.Size = UDim2.fromScale((settings[key] - low) / (high - low), 1)
        caption.Text = text .. ": " .. string.format("%.2f", settings[key])
    end
    local function update(x)
        local t = math.clamp((x - track.AbsolutePosition.X)
            / math.max(track.AbsoluteSize.X, 1), 0, 1)
        settings[key] = math.clamp(math.round((low + t * (high-low)) / step) * step, low, high)
        refresh()
    end
    connect(track.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliderDrag = update
            update(input.Position.X)
        end
    end)
    refresh()
    table.insert(refreshControls, refresh)
end

