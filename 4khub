    ESP = true, ESPPlayers = true, ESPNPCs = false, Boxes = true, Skeleton = true, Names = true,
    Distance = true, Health = true, TeamFilter = false,
    Aim = false, AimPlayers = true, AimNPCs = false, Sticky = true, Instant = false, VisibleOnly = true, Circle = true,
    Radius = 160, Strength = 8, Range = 1000, Thickness = 2,
    Hue = 0.57, Target = "Head", BoxStyle = "Completa",
    HubBind = "KeyCode:RightShift", AimBind = "UserInputType:MouseButton2",
    AimMode = "Segurar",
}
local keyboardBindings = {}
for _, key in ipairs(Enum.KeyCode:GetEnumItems()) do
    if key ~= Enum.KeyCode.Unknown and key ~= Enum.KeyCode.Escape
        and not key.Name:match("^Button") and not key.Name:match("^DPad")
        and not key.Name:match("^Thumbstick") then
        keyboardBindings["KeyCode:" .. key.Name] = key
    end
end
local mouseBindings = {
    ["UserInputType:MouseButton1"] = Enum.UserInputType.MouseButton1,
    ["UserInputType:MouseButton2"] = Enum.UserInputType.MouseButton2,
    ["UserInputType:MouseButton3"] = Enum.UserInputType.MouseButton3,
}
local function validBinding(value)
    return keyboardBindings[value] ~= nil or mouseBindings[value] ~= nil
end
local function inputBinding(input)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        local value = "KeyCode:" .. input.KeyCode.Name
        if keyboardBindings[value] then return value end
    else
        local value = "UserInputType:" .. input.UserInputType.Name
        if mouseBindings[value] then return value end
    end
    return nil
end
local function bindingLabel(value)
    local labels = {
        ["UserInputType:MouseButton1"] = "Mouse esquerdo",
        ["UserInputType:MouseButton2"] = "Mouse direito",
        ["UserInputType:MouseButton3"] = "Mouse central",
    }
    return labels[value] or value:gsub("^KeyCode:", "")
end
local pendingBind, bindingRelease, aimLatched = nil, nil, false
local function resetInputState()
    pendingBind, bindingRelease, aimLatched = nil, nil, false
end
local function aimInputActive()
    if pendingBind or bindingRelease then return false end
    if settings.AimMode == "Alternar" then return aimLatched end
    local key = keyboardBindings[settings.AimBind]
    if key then return UIS:IsKeyDown(key) end
    local mouse = mouseBindings[settings.AimBind]
    return mouse ~= nil and UIS:IsMouseButtonPressed(mouse)
end
