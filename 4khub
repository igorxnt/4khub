local statsElapsed = 0
RunService:BindToRenderStep(binding, Enum.RenderPriority.Last.Value + 1, function(dt)
    if dead then return end
    local camera = workspace.CurrentCamera
    if not camera then return end
    if menuOpen then releaseMouse() end
    accent = Color3.fromHSV(settings.Hue,0.7,1)
    header.TextColor3, border.Color, status.TextColor3 = accent,accent,accent
    local view = camera.ViewportSize
    panel.Size = UDim2.fromOffset(math.min(600, math.max(280, view.X-24)),
        math.min(560, math.max(200, view.Y-100)))
    if not panelDrag then
        panel.Position = UDim2.fromOffset(
            math.clamp(panel.Position.X.Offset,0,math.max(0,view.X-panel.AbsoluteSize.X)),
            math.clamp(panel.Position.Y.Offset,0,math.max(0,view.Y-panel.AbsoluteSize.Y)))
    end
    local inset = GuiService:GetGuiInset()
    status.Position = UDim2.fromOffset(12, inset.Y+8)
    local center = view/2
    status.Size = UDim2.fromOffset(math.min(510, math.max(200,view.X-24)),25)
    circle.Position = UDim2.fromOffset(center.X,center.Y)
    circle.Size = UDim2.fromOffset(settings.Radius*2,settings.Radius*2)
    circle.Visible = settings.Aim and settings.Circle
    circleStroke.Color = accent
    local localRoot = player.Character and findBodyPart(player.Character,"HumanoidRootPart")
    local origin = localRoot and localRoot.Position or camera.CFrame.Position
    local bestPosition, bestScore, tracked = nil, settings.Radius, 0
    local counts = {total=0,noCharacter=0,noHumanoid=0,noRoot=0,dead=0,team=0,range=0}
    local ownHumanoid = player.Character and player.Character:FindFirstChildWhichIsA("Humanoid",true)
    local aiming = settings.Aim and not menuOpen and player.Character
        and (not ownHumanoid or ownHumanoid.Health > 0)
        and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        and not UIS:GetFocusedTextBox() and not GuiService.MenuIsOpen
    for p, record in pairs(records) do
        counts.total += 1
        record.Root.Visible = false
        for _, l in ipairs(record.Lines) do l.Visible = false end
        for _, l in ipairs(record.Corners) do l.Visible = false end
        local character = p.Character
        if not character then counts.noCharacter += 1; continue end
        if record.Character ~= character then bindRig(record, character) end
        local hum = character:FindFirstChildWhichIsA("Humanoid",true)
        local root = findBodyPart(character,"HumanoidRootPart")
        local target = findBodyPart(character,settings.Target)
        if not hum then counts.noHumanoid += 1; continue end
        if hum.Health <= 0 then counts.dead += 1; continue end
        if not root then counts.noRoot += 1; continue end
        local allied = player.Team ~= nil and p.Team == player.Team
            and not player.Neutral and not p.Neutral
        if settings.TeamFilter and allied then counts.team += 1; continue end
        local distance = (root.Position-origin).Magnitude
        if distance > settings.Range then counts.range += 1; continue end
        tracked += 1
        if aiming and target and target:IsA("BasePart") then
            local point, shown = project(camera,target.Position)
            local score = (point-center).Magnitude
            if shown and score < bestScore and (not settings.VisibleOnly
                or unobstructed(camera,character,target.Position)) then
                bestPosition, bestScore = target.Position,score
            end
        end
        if not settings.ESP then continue end
        local lo,hi = bounds(camera,character)
        if not lo then continue end
        record.Root.Visible = true
        record.Box.Visible = settings.Boxes and settings.BoxStyle == "Completa"
        record.Box.Position = UDim2.fromOffset(lo.X,lo.Y)
        record.Box.Size = UDim2.fromOffset(hi.X-lo.X,hi.Y-lo.Y)
        record.Stroke.Color, record.Stroke.Thickness = accent,settings.Thickness
        if settings.Boxes and settings.BoxStyle == "Cantos" then
            local w,h = (hi.X-lo.X)*0.23,(hi.Y-lo.Y)*0.19
            local segments = {
                {lo,lo+Vector2.new(w,0)}, {lo,lo+Vector2.new(0,h)},
                {Vector2.new(hi.X,lo.Y),Vector2.new(hi.X-w,lo.Y)},
                {Vector2.new(hi.X,lo.Y),Vector2.new(hi.X,lo.Y+h)},
                {Vector2.new(lo.X,hi.Y),Vector2.new(lo.X+w,hi.Y)},
                {Vector2.new(lo.X,hi.Y),Vector2.new(lo.X,hi.Y-h)},
                {hi,hi-Vector2.new(w,0)}, {hi,hi-Vector2.new(0,h)},
            }
            for index, segment in ipairs(segments) do
                if not record.Corners[index] then
                    record.Corners[index] = newLine(record.Root)
                end
                drawLine(record.Corners[index],segment[1],segment[2])
            end
        end
        local text = {}
        if settings.Names then table.insert(text,p.DisplayName) end
        if settings.Distance then table.insert(text,string.format("%.0f studs",distance)) end
        if settings.Health then table.insert(text,string.format("HP %.0f",hum.Health)) end
        record.Text.Visible = #text > 0
        record.Text.Text = table.concat(text," | ")
        record.Text.TextColor3 = accent
        record.Text.Position = UDim2.fromOffset((lo.X+hi.X)/2,lo.Y-4)
        local fraction = math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
        record.Health.Visible = settings.Health
        record.Health.Position = UDim2.fromOffset(lo.X-6,hi.Y-(hi.Y-lo.Y)*fraction)
        record.Health.Size = UDim2.fromOffset(3,(hi.Y-lo.Y)*fraction)
        record.Health.BackgroundColor3 = Color3.fromHSV(fraction/3,0.8,1)
        if settings.Skeleton then
            local index = 0
            for joint in pairs(record.Joints) do
                local a,b = joint.Part0,joint.Part1
                if not a or not b or not a:IsDescendantOf(character)
                    or not b:IsDescendantOf(character)
                    or a:FindFirstAncestorOfClass("Tool")
                    or b:FindFirstAncestorOfClass("Tool")
                    or a:FindFirstAncestorOfClass("Accessory")
                    or b:FindFirstAncestorOfClass("Accessory") then continue end
                local pa,va = project(camera,a.Position)
                local pb,vb = project(camera,b.Position)
                if va and vb then
                    index += 1
                    if not record.Lines[index] then record.Lines[index] = newLine(record.Root) end
                    drawLine(record.Lines[index],pa,pb)
                end
            end
        end
    end
    if aiming and bestPosition and (bestPosition-camera.CFrame.Position).Magnitude > 0.01 then
        local desired = CFrame.lookAt(camera.CFrame.Position,bestPosition)
        local alpha = settings.Instant and 1 or 1-math.exp(-settings.Strength*dt)
        camera.CFrame = camera.CFrame:Lerp(desired,alpha)
    end
    statsElapsed += dt
    if statsElapsed >= 0.25 then
        statsElapsed = 0
        status.Text = string.format("4k hub • %d alvos • menu %s • aim %s", tracked,
            menuOpen and "aberto" or "fechado",settings.Aim and "ON" or "OFF")
        diagnostics.Text = string.format(
            "PlaceId: %s\nOutros jogadores: %d | elegíveis: %d\nSem Character: %d | sem Humanoid: %d\nSem parte corporal: %d | mortos: %d\nFiltrados por equipe: %d | distância: %d\nRig personalizado sem Humanoid exige adaptação específica.",
            tostring(game.PlaceId),counts.total,tracked,counts.noCharacter,
            counts.noHumanoid,counts.noRoot,counts.dead,counts.team,counts.range)
    end
end)
