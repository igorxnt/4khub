    records[p] = {Root=root, Box=box, Stroke=stroke, Text=text,
        Health=health, Lines={}, Corners={}, Character=nil, Joints={}, RigConnections={}}
end
local function disconnectRig(record)
    for _, c in ipairs(record.RigConnections) do c:Disconnect() end
    table.clear(record.RigConnections)
end
local function bindRig(record, character)
    disconnectRig(record)
    record.Character = character
    table.clear(record.Joints)
    local function add(object)
        if object:IsA("Motor6D") then record.Joints[object] = true end
    end
    for _, obj in ipairs(character:GetDescendants()) do add(obj) end
    table.insert(record.RigConnections, character.DescendantAdded:Connect(add))
    table.insert(record.RigConnections, character.DescendantRemoving:Connect(function(obj)
        record.Joints[obj] = nil
    end))
end
local function removePlayer(p)
    local record = records[p]
    if record then disconnectRig(record); record.Root:Destroy() end
    records[p] = nil
end
for _, p in ipairs(Players:GetPlayers()) do addPlayer(p) end
