connect(header.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        panelDrag, dragOrigin, panelOrigin = true, input.Position, panel.Position
    end
end)
connect(UIS.InputChanged, function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
    if sliderDrag then sliderDrag(input.Position.X) end
    if panelDrag then
        local delta = input.Position - dragOrigin
        local camera = workspace.CurrentCamera
        if camera then
            local view = camera.ViewportSize
            panel.Position = UDim2.fromOffset(
                math.clamp(panelOrigin.X.Offset + delta.X, 0, math.max(0, view.X-panel.AbsoluteSize.X)),
                math.clamp(panelOrigin.Y.Offset + delta.Y, 0, math.max(0, view.Y-panel.AbsoluteSize.Y)))
        end
    end
end)
connect(UIS.InputEnded, function(input)
    if inputBinding(input) == bindingRelease then bindingRelease = nil end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderDrag, panelDrag = nil, false
    end
end)
connect(UIS.InputBegan, function(input, processed)
    if pendingBind then
        if input.KeyCode == Enum.KeyCode.Escape then
            pendingBind = nil
            bindingMessage.Text = "Escolha cancelada. Atalho anterior mantido."
            refreshBindingButtons()
            return
        end
        local value = inputBinding(input)
        if not value then return end
        local other = pendingBind == "HubBind" and "AimBind" or "HubBind"
        if value == settings[other] then
            bindingMessage.Text = "Esse atalho já está em uso. Escolha outro ou pressione Esc."
            return
        end
        settings[pendingBind] = value
        pendingBind, bindingRelease, aimLatched = nil, value, false
        bindingMessage.Text = "Atalho atualizado."
        refreshBindingButtons()
        return
    end
    if UIS:GetFocusedTextBox() or GuiService.MenuIsOpen then return end
    local value = inputBinding(input)
    if menuOpen and processed and mouseBindings[value] then return end
    if value == settings.HubBind then
        setMenu(not menuOpen)
    elseif value == settings.AimBind and settings.AimMode == "Alternar"
        and settings.Aim and not menuOpen then
        aimLatched = not aimLatched
    end
end)
connect(UIS.WindowFocusReleased, function()
    sliderDrag, panelDrag = nil, false
    resetInputState()
    refreshBindingButtons()
end)

