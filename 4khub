connect(Players.PlayerRemoving, removePlayer)
local function project(camera, position)
    local p, shown = camera:WorldToViewportPoint(position)
    return Vector2.new(p.X,p.Y), shown and p.Z > 0
end
local function bounds(camera, character)
    local cf, size = character:GetBoundingBox()
    local lo, hi = Vector2.new(math.huge, math.huge), Vector2.new(-math.huge,-math.huge)
    for x=-1,1,2 do for y=-1,1,2 do for z=-1,1,2 do
        local p = camera:WorldToViewportPoint(cf:PointToWorldSpace(
            Vector3.new(size.X*x/2,size.Y*y/2,size.Z*z/2)))
        if p.Z <= 0 then return nil end
        lo = Vector2.new(math.min(lo.X,p.X),math.min(lo.Y,p.Y))
        hi = Vector2.new(math.max(hi.X,p.X),math.max(hi.Y,p.Y))
    end end end
    if hi.X < 0 or hi.Y < 0 or lo.X > camera.ViewportSize.X
        or lo.Y > camera.ViewportSize.Y then return nil end
    return lo, hi
end
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
local function unobstructed(camera, character, position)
    local ignore = {camera}
    if player.Character then table.insert(ignore, player.Character) end
    params.FilterDescendantsInstances = ignore
    local hit = workspace:Raycast(camera.CFrame.Position,
        position-camera.CFrame.Position, params)
    return not hit or hit.Instance:IsDescendantOf(character)
end
local function findBodyPart(character, preferred)
    for _, name in ipairs({preferred, "HumanoidRootPart", "UpperTorso", "Torso", "Head"}) do
        local part = character:FindFirstChild(name, true)
        if part and part:IsA("BasePart")
            and not part:FindFirstAncestorOfClass("Tool")
            and not part:FindFirstAncestorOfClass("Accessory") then return part end
    end
    return character.PrimaryPart
end
local function cleanup()
    if dead then return end
    dead = true
    RunService:UnbindFromRenderStep(binding)
    for _, c in ipairs(connections) do c:Disconnect() end
    for _, record in pairs(records) do disconnectRig(record) end
    if menuOpen then
        if savedBehavior then UIS.MouseBehavior = savedBehavior end
        if savedIcon ~= nil then UIS.MouseIconEnabled = savedIcon end
    end
end
gui.Destroying:Connect(cleanup)
