local function newLine(parent)
    return create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Visible = false,
    }, parent)
end
local function drawLine(obj, a, b)
    local d = b-a
    obj.Position = UDim2.fromOffset((a.X+b.X)/2, (a.Y+b.Y)/2)
    obj.Size = UDim2.fromOffset(d.Magnitude, settings.Thickness)
    obj.Rotation = math.deg(math.atan2(d.Y, d.X))
    obj.BackgroundColor3 = accent
    obj.Visible = true
end
